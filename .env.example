# ── Required: OpenAI (default provider) ───────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: Anthropic (only if switching PLANNER_PROVIDER=anthropic) ─────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Provider routing (defaults match the values below — uncomment to override) ─
# PLANNER_PROVIDER=openai
# CRITIC_PROVIDER=openai

# ── OpenAI model names ─────────────────────────────────────────────────────────
# PLANNER_MODEL_OPENAI=gpt-5.4-mini
# CRITIC_MODEL_OPENAI=gpt-5.4-mini

# ── Local Ollama fallback (CPU inference) ──────────────────────────────────────
# PLANNER_PROVIDER=ollama
# CRITIC_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# PLANNER_MODEL_LOCAL=mistral
# CRITIC_MODEL_LOCAL=phi4-mini

# ── Trace store ────────────────────────────────────────────────────────────────
# AETHER_DB_PATH=./aether_trace.db

# ── Embeddings (local, no API key needed) ──────────────────────────────────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval tuning ───────────────────────────────────────────────────────────
# DENSE_TOP_K=20
# BM25_TOP_K=20
# RERANK_TOP_K=5

# ── Logging ────────────────────────────────────────────────────────────────────
# AETHER_LOG_LEVEL=INFO

# ── Data paths ─────────────────────────────────────────────────────────────────
# DATA_UPLOAD_DIR=./data/uploads
# DATA_DEMO_DIR=./data/demo

# ══════════════════════════════════════════════════════════════════════════
# GTM Lead-Triage — Render deploy env vars (copy these into Render dashboard)
# ══════════════════════════════════════════════════════════════════════════

# ── Core agent ────────────────────────────────────────────────────────────
#GTM_PROVIDER=mock
#GTM_MODEL=gpt-4o-mini
#CRM_BACKEND=hubspot

# ── Postgres trace store (Neon) ───────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── HubSpot CRM ──────────────────────────────────────────────────────────
HUBSPOT_TOKEN=pat-na1-...

# ── OpenAI (only when GTM_PROVIDER=openai) ────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── CORS (your Vercel URL — update after Vercel deploy) ───────────────────
FRONTEND_ORIGIN=https://your-app.vercel.app,http://localhost:3000

# ── Langfuse observability (optional) ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ── Enrichment (firmographics) ────────────────────────────────────────────
ENRICHMENT_PROVIDER=mock          # mock | pdl
# PDL_API_KEY=...                  # People Data Labs (free: 100 lookups/mo, emails obfuscated)

# ── Company-research grounding (Phase 2) ──────────────────────────────────
# COMPANY_RESEARCH=off            # off | on  — website-read + search -> cited brief
# SEARCH_PROVIDER=off             # off | brave | tavily
# BRAVE_API_KEY=...               # Brave Search API (free tier)
# TAVILY_API_KEY=tvly-...         # Tavily (free tier) — pick ONE search provider

# ── Productboard connector (Phase 1, built) ───────────────────────────────
PRODUCTBOARD_SOURCE=fixture       # fixture | live | off
# PRODUCTBOARD_TOKEN=...          # only needed when PRODUCTBOARD_SOURCE=live

# ── Apollo population / sourcing (Phase 3) ────────────────────────────────
APOLLO_SOURCE=fixture             # fixture | live | off
# APOLLO_API_KEY=...              # Apollo.io (free tier) — put your key here

# ── API hardening (production) ────────────────────────────────────────────
# APP_ENV=development             # set to "production" to enable fail-closed auth
# GTM_API_KEYS=key1,key2          # required when APP_ENV=production
# DAILY_QUERY_CAP=200             # max real LLM runs per UTC day (then mock)

# ══════════════════════════════════════════════════════════════════════════
# Vercel env var (set in Vercel dashboard, not here)
# ══════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_API_URL=https://gtm-triage-api.onrender.com

# ══════════════════════════════════════════════════════════════════════════
# Local dev only (ignored when DATABASE_URL is set)
# ══════════════════════════════════════════════════════════════════════════
# GTM_CRM_DB=gtm_crm.db
# GTM_TRACE_DB=gtm_trace.db