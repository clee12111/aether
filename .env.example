# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Model ─────────────────────────────────────────────────────────────────────
# Use the most capable available Sonnet model
CLAUDE_MODEL=claude-sonnet-4-6
MAX_RETRIES=3

# ── Qdrant (local Docker) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=aether

# ── Trace store ───────────────────────────────────────────────────────────────
AETHER_DB_PATH=./aether_trace.db

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Logging ───────────────────────────────────────────────────────────────────
AETHER_LOG_LEVEL=INFO

# ── Data paths ────────────────────────────────────────────────────────────────
DATA_UPLOAD_DIR=./data/uploads
DATA_DEMO_DIR=./data/demo
