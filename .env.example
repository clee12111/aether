# ── Required: OpenAI (default provider) ───────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: Anthropic (only if switching PLANNER_PROVIDER=anthropic) ─────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Provider routing (defaults match the values below — uncomment to override) ─
# PLANNER_PROVIDER=openai
# CRITIC_PROVIDER=openai

# ── OpenAI model names ─────────────────────────────────────────────────────────
# PLANNER_MODEL_OPENAI=gpt-5.4-mini
# CRITIC_MODEL_OPENAI=gpt-5.4-mini

# ── Local Ollama fallback (CPU inference) ──────────────────────────────────────
# PLANNER_PROVIDER=ollama
# CRITIC_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# PLANNER_MODEL_LOCAL=mistral
# CRITIC_MODEL_LOCAL=phi4-mini

# ── Trace store ────────────────────────────────────────────────────────────────
# AETHER_DB_PATH=./aether_trace.db

# ── Embeddings (local, no API key needed) ──────────────────────────────────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval tuning ───────────────────────────────────────────────────────────
# DENSE_TOP_K=20
# BM25_TOP_K=20
# RERANK_TOP_K=5

# ── Logging ────────────────────────────────────────────────────────────────────
# AETHER_LOG_LEVEL=INFO

# ── Data paths ─────────────────────────────────────────────────────────────────
# DATA_UPLOAD_DIR=./data/uploads
# DATA_DEMO_DIR=./data/demo

# ── GTM Lead-Triage Agent ──────────────────────────────────────────────────
# GTM_PROVIDER=mock            # "mock" (default, no API key) or "openai"
# GTM_MODEL=gpt-4o-mini        # model for openai provider
# CRM_BACKEND=sqlite           # "sqlite" (default) or "hubspot"
# GTM_CRM_DB=gtm_crm.db
# GTM_TRACE_DB=gtm_trace.db

# ── HubSpot CRM (only when CRM_BACKEND=hubspot) ──────────────────────────
# HUBSPOT_TOKEN=pat-na1-...

# ── Langfuse observability (optional — no-op when absent) ─────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com